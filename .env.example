# Copia este archivo como .env para personalizar la configuración.

# Puerto donde se abre la aplicación en tu navegador
APP_PORT=8080

# Saldo inicial de la cuenta demo (USDT ficticios)
INITIAL_BALANCE=10000

# Comisión simulada por operación (0.001 = 0,1%)
FEE_RATE=0.001

# Cada cuántos segundos se refrescan precios y alertas
POLL_INTERVAL=3
